    (function(){try{
    if(window.__gtgHealthBlocker&&window.__gtgHealthBlocker.installed){return;}
    function isHealthRequest(url){
    try{
    var raw=typeof url==='string'?url:String(url==null?'':url);
    if(!raw||raw.indexOf('gtg_health')===-1){return false;}
    var parsed=new URL(raw,document.baseURI||'https://localhost/');
    var host=parsed.hostname.toLowerCase();
    if(host!=='googletagmanager.com'&&!host.endsWith('.googletagmanager.com')){return false;}
    return parsed.searchParams.has('gtg_health');
    }catch(e){return false;}
    }
    var state={installed:false,blocked:0,errorsDispatched:0,isHealthRequest:isHealthRequest};
    window.__gtgHealthBlocker=state;
    var srcDescriptor=Object.getOwnPropertyDescriptor(HTMLScriptElement.prototype,'src');
    if(!srcDescriptor||!srcDescriptor.get||!srcDescriptor.set){return;}
    var nativeSetAttribute=Element.prototype.setAttribute;
    var previousCreateElement=document.createElement;
    function neutralize(el){
    state.blocked++;
    setTimeout(function(){try{if(el.isConnected){state.errorsDispatched++;el.dispatchEvent(new Event('error'));}}catch(e){}},0);
    }
    function guard(el){
    Object.defineProperty(el,'src',{configurable:true,enumerable:false,
    get:function(){return srcDescriptor.get.call(this);},
    set:function(value){if(isHealthRequest(value)){neutralize(this);return;}srcDescriptor.set.call(this,value);}});
    Object.defineProperty(el,'setAttribute',{configurable:true,enumerable:false,writable:true,
    value:function(name,value){
    if(String(name).toLowerCase()==='src'&&isHealthRequest(value)){neutralize(this);return;}
    return nativeSetAttribute.apply(this,arguments);
    }});
    }
    document.createElement=function(tagName){
    var el=previousCreateElement.apply(this,arguments);
    try{if(typeof tagName==='string'&&tagName.length===6&&tagName.toLowerCase()==='script'){guard(el);}}catch(e){}
    return el;
    };
    state.installed=true;
    }catch(e){}})();
</script>

