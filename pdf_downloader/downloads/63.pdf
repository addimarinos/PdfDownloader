<script type="text/javascript">
  function OptanonWrapper() { }

  setTimeout(function(){
    const closeBtns = document.querySelectorAll("#close-pc-btn-handler, .ot-floating-button__close");
    const url = window.location.href;

    // Check selector + URL condition
    if (closeBtns.length > 0 && (url.includes(".cm.") || url.includes(".cd."))) {
      closeBtns.forEach(btn => {
        btn.addEventListener("click", function () {
          setTimeout(function(){
            const darkFilter = document.querySelector(".onetrust-pc-dark-filter");
            if (darkFilter) {
              darkFilter.style.display = "none ";
            }
          }, 500);
        });
      });
    } 
  }, 500);

</script>
